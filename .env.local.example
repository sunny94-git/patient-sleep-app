# ============================================================
# 수면장애 클리닉 환자 앱 — 환경 변수 설정
# 이 파일을 복사하여 .env.local 로 이름을 바꾸고 값을 채워주세요.
# .env.local 은 절대 Git에 커밋하지 마세요.
# ============================================================

# Supabase 프로젝트 설정
# Supabase Dashboard > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (서버 전용, 클라이언트에 절대 노출 금지)
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 앱 URL (배포 시 실제 도메인으로 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000
